algoritmo "EXERCÍCIO03"
var
//variáveis
idade: inteiro
dobro: inteiro

inicio
//entrada
escreval("Qual a sua idade:")
               leia (idade)
               se (idade >= 18) entao
               escreval ("Parabéns, você já pode dirigir")
               senao
               escreval("Infelizmente, você ainda não pode dirigir")
               fimse
fimalgoritmo