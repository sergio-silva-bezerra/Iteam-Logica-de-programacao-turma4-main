Algoritmo "Login"

Var
senha: inteiro



Inicio
      escreval("Digite sua senha: ")
      leia(senha)
      enquanto senha <> 1234 faca
               escreval("Senha incorreta")
               escreval ("Tente novamente")
               Leia(senha)
      fimenquanto
      escreval("Senha correta!")

Fimalgoritmo